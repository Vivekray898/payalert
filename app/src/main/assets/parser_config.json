{
  "schemaVersion": 1,
  "defaultCurrency": "INR",
  "coordinator": {
    "dedupWindowMinutes": 5,
    "amountBucketMinutes": 5,
    "staleGraceHours": 48
  },
  "patterns": {
    "amount": [
      "(?i)(?:rs\\.?|inr|\\u20b9)\\s*([0-9][0-9,]*(?:\\.[0-9]{1,2})?)",
      "(?i)(?:amount|amt)\\.?\\s*(?:of|:)?\\s*(?:rs\\.?|inr|\\u20b9)?\\s*([0-9][0-9,]*(?:\\.[0-9]{1,2})?)",
      "(?i)([0-9][0-9,]*\\.[0-9]{2})\\s*(?:rs\\b|inr\\b)",
      "(?i)\\b(?:received|credited|got)\\s*(?:rs\\.?|inr|\\u20b9)?\\s*([0-9][0-9,]*(?:\\.[0-9]{1,2})?)",
      "(?i)([0-9][0-9,]*(?:\\.[0-9]{1,2})?)\\s+rupees?\\b"
    ],
    "reference": [
      "(?i)(?:utr|rrn|upi\\s*ref|ref(?:erence)?\\s*(?:no\\.?|number|id)?|txn\\s*id|transaction\\s*id)\\s*[:#]?\\s*([A-Za-z0-9]{6,22})",
      "\\b([0-9]{12})\\b",
      "\\b([A-Z]{4}[0-9]{6,12})\\b"
    ],
    "account": [
      "\\b([xX*\\u2022]{2,}\\s?[0-9]{3,4})\\b",
      "(?i)(?:a/?c|acct|account|card)\\s*(?:no\\.?|number|ending|xx+)?\\s*[:#]?\\s*([0-9]{3,4})\\b"
    ],
    "balance": [
      "(?i)(?:avl\\.?\\s*bal|available\\s*bal(?:ance)?|bal(?:ance)?|updated\\s*balance)\\s*[:.=]?\\s*(?:rs\\.?|inr|\\u20b9)?\\s*([0-9][0-9,]*(?:\\.[0-9]{1,2})?)"
    ]
  },
  "skip": {
    "otp": ["otp", "one time password", "one-time password", "verification code", "do not share", "never share", "valid for next"],
    "dueReminder": ["is due", "due on", "due date", "emi of", "emi is", "minimum amount due", "payment due", "will be debited", "will be deducted", "is scheduled", "overdue", "kindly pay", "please pay"],
    "promo": ["offer", "discount", "bonus", "pre-approved", "pre approved", "apply now", "avail", "congratulations", "you have won", "click the link", "click here", "limited period", "t&c apply", "get up to"],
    "delivery": ["out for delivery", "is delivered", "has been delivered", "shipped", "dispatched", "will be delivered"],
    "request": ["has requested", "collect request", "has requested money", "payment request", "requesting you to pay"],
    "declined": ["declined", "payment failed", "has failed", "unsuccessful", "insufficient", "cannot be processed", "not processed", "transaction failed"]
  },
  "direction": {
    "debit": ["debited", "debit", "withdrawn", "withdrawal", "spent", "paid", "sent", "deducted", "purchase", "transferred", "charged"],
    "credit": ["credited", "credit", "received", "deposited", "refund", "cashback", "reversed", "added", "money received", "paid you", "sent you", "sent to you", "transferred to you"],
    "debitWins": ["debited", "debit", "spent", "withdrawn", "deducted"]
  },
  "merchant": {
    "credit": [
      "(?i)\\bfrom\\s+(.{2,40}?)\\s*(?:\\.|,|;|\\bon\\b|\\bat\\b|\\bref\\b|\\butr\\b|\\bupi\\b|\\bbal\\b|\\bamount\\b|$)",
      "(?i)^(.{2,40}?)\\s+paid\\s+you\\b",
      "(?i)^(.{2,40}?)\\s+sent\\s+you\\b",
      "(?i)\\bby\\s+(.{2,40}?)\\s*(?:\\.|,|;|\\bon\\b|\\bat\\b|\\bref\\b|$)",
      "(?i)\\bat\\s+(.{2,40}?)\\s*(?:\\.|,|;|\\bon\\b|\\bref\\b|$)"
    ],
    "debit": [
      "(?i)\\bto\\s+(.{2,40}?)\\s*(?:\\.|,|;|\\bon\\b|\\bat\\b|\\bref\\b|\\butr\\b|\\bupi\\b|\\bbal\\b|\\bfrom\\b|\\bvia\\b|\\busing\\b|\\ba/?c\\b|$)",
      "(?i)\\bat\\s+(.{2,40}?)\\s*(?:\\.|,|;|\\bon\\b|\\bref\\b|\\bfrom\\b|\\bvia\\b|$)",
      "(?i)\\bfor\\s+(.{2,40}?)\\s*(?:\\.|,|;|\\bon\\b|\\bref\\b|\\bfrom\\b|$)",
      "(?i)\\btowards\\s+(.{2,40}?)\\s*(?:\\.|,|;|\\bon\\b|\\bref\\b|\\bfrom\\b|$)"
    ],
    "stopWords": ["your", "a/c", "ac", "account", "the", "this", "a", "an", "your account", "your a/c", "bank", "bank account", "unknown", "rs", "inr", "upi"],
    "upiNarration": "(?i)\\bUPI/([^/\\s]{2,30})(?:/[^/\\s]{2,30}){0,2}",
    "vpa": "(?i)\\b([a-z0-9._-]{2,30}@[a-z]{2,15})\\b",
    "upiHandlesToIgnore": ["PAYTM", "PHONEPE", "GPAY", "OKAXIS", "OKHDFCBANK", "OKICICI", "OKSBI", "YOBL", "IBL", "AXL", "APL"]
  },
  "currency": {
