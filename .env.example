# PayAlert — local configuration template
# Never commit real credentials. Copy to .env and fill values before building.
# This file is git-ignored; add it to .gitignore if not already present.

# Supabase (required for auth, device tracking, event sync)
# These are the publishable keys — never the service_role secret.
# Use the current publishable key format: sb_publishable_...
SUPABASE_PUBLISHABLE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Optional: customise default behaviours
# ANDROID_MIN_SDK=24
# ANDROID_TARGET_SDK=34

# App display
APP_DISPLAY_NAME=PayAlert